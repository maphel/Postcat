{
  "name": "postcat",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Chrome DevTools extension: capture, edit and replay network requests.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e.js && npm run test:qa",
    "test:qa": "node test/qa.js && node test/worker-qa.js && node test/vault-qa.js",
    "test:real": "node test/real-devtools.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run test:e2e && npm run test:real",
    "pack": "node scripts/pack.js",
    "stamp": "node scripts/stamp.js",
    "release": "node scripts/release.js",
    "changelog:section": "node scripts/changelog-section.js",
    "screenshot": "node scripts/screenshot.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.64.1"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.4"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maphel/Postcat.git"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "chrome-extension",
    "devtools",
    "http",
    "api-testing",
    "api-client"
  ],
  "homepage": "https://github.com/maphel/Postcat",
  "bugs": "https://github.com/maphel/Postcat/issues"
}
